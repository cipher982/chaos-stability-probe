<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{ bundle.title }}</title>
<style>
  :root {
    --bg: #f6f5ef;
    --panel: #fffefa;
    --ink: #17191c;
    --soft: #4c535d;
    --muted: #7b828c;
    --line: #d7d4c8;
    --line-strong: #a9a59a;
    --blue: #265f78;
    --blue-bg: #dceaf0;
    --gold: #8a611d;
    --gold-bg: #f1e4c8;
    --green: #2f6847;
    --green-bg: #dcebdc;
    --red: #8b3532;
    --red-bg: #f1dad6;
    --violet: #574b86;
    --violet-bg: #e4dfef;
    --slate: #46515f;
    --slate-bg: #e5e8ec;
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 14px/1.48 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .shell {
    display: grid;
    grid-template-columns: 244px minmax(0, 1fr);
    min-height: 100vh;
    min-width: 0;
  }

  .rail {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: auto;
    background: #ebe9df;
    border-right: 1px solid var(--line);
    padding: 20px 16px;
    min-width: 0;
    max-width: 100%;
  }

  .brand {
    font-size: 12px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 3px;
  }

  .rail h1 {
    font-size: 15px;
    line-height: 1.25;
    margin: 0 0 14px;
    font-weight: 650;
  }

  .nav {
    display: grid;
    gap: 4px;
    margin: 16px 0;
  }

  .nav a {
    color: var(--ink);
    text-decoration: none;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 7px 9px;
    font-size: 13px;
  }

  .nav a:hover,
  .nav a.active {
    background: var(--panel);
    border-color: var(--line-strong);
  }

  .rail .meta {
    border-top: 1px solid var(--line);
    padding-top: 12px;
    font: 11.5px/1.42 var(--mono);
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  main {
    width: min(1120px, 100%);
    padding: 28px 34px 80px;
    min-width: 0;
    max-width: 100%;
  }

  .hero {
    border-bottom: 1px solid var(--line);
    padding-bottom: 16px;
    margin-bottom: 24px;
  }

  .hero .kicker {
    color: var(--muted);
    font: 11px/1.4 var(--mono);
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .hero h2 {
    font-size: 22px;
    letter-spacing: -.01em;
    margin: 2px 0 5px;
  }

  .hero p {
    color: var(--soft);
    margin: 0;
    max-width: 820px;
  }

  section {
    margin: 30px 0 42px;
    scroll-margin-top: 18px;
  }

  section > h3 {
    font-size: 16px;
    margin: 0 0 6px;
  }

  section > p {
    margin: 0 0 14px;
    color: var(--soft);
    max-width: 850px;
  }

  .panel {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 15px;
    min-width: 0;
    max-width: 100%;
  }

  .panel h4 {
    margin: 0 0 10px;
    font: 11.5px/1.3 var(--mono);
    letter-spacing: .06em;
    color: var(--muted);
    text-transform: uppercase;
  }

  .case-name {
    margin: 4px 0 10px;
    color: var(--muted);
    font: 12px/1.4 var(--mono);
    letter-spacing: .04em;
    overflow-wrap: anywhere;
  }

  .grid2 {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 12px;
    min-width: 0;
  }

  .grid3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    min-width: 0;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    align-items: center;
    margin-bottom: 12px;
  }

  .case-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-bottom: 14px;
  }

  .case-card {
    text-align: left;
    display: grid;
    gap: 7px;
    align-content: start;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: #fff;
    min-height: 150px;
    padding: 12px;
  }

  .case-card.active {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }

  .case-card.active .case-card-body,
  .case-card.active .case-card-meta {
    color: #e7e4da;
  }

  .case-card-title {
    font-weight: 650;
    font-size: 14px;
  }

  .case-card-body {
    color: var(--soft);
    font-size: 12.5px;
    line-height: 1.35;
  }

  .case-card-fields {
    display: grid;
    gap: 4px;
    font: 11.5px/1.35 var(--mono);
    color: var(--soft);
  }

  .case-field {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 6px;
  }

  .case-field-label {
    color: var(--muted);
    text-transform: uppercase;
    font-size: 10.5px;
    letter-spacing: .04em;
    align-self: center;
  }

  .case-field-value {
    overflow-wrap: anywhere;
  }

  .case-card.active .case-field-label,
  .case-card.active .case-card-fields {
    color: #e7e4da;
  }

  .case-card-meta {
    color: var(--muted);
    font: 11.5px/1.35 var(--mono);
  }

  .case-detail {
    border-top: 1px solid var(--line);
    padding-top: 12px;
  }

  .case-id {
    color: var(--muted);
    font: 13px/1.5 var(--mono);
    letter-spacing: 0;
  }

  .inline-note {
    margin: 10px 0;
    border: 1px solid var(--line);
    border-left: 4px solid var(--blue);
    border-radius: 5px;
    background: #faf9f3;
    padding: 9px 11px;
    color: var(--soft);
  }

  details.disclosure {
    border: 1px solid var(--line);
    border-radius: 5px;
    background: #fbfaf5;
    padding: 10px 12px;
    margin: 10px 0;
  }

  details.disclosure > summary {
    cursor: pointer;
    font-weight: 650;
  }

  details.disclosure > .controls,
  details.disclosure > .panel,
  details.disclosure > .source-list {
    margin-top: 10px;
  }

  button,
  select,
  input[type="range"] {
    font: inherit;
  }

  button,
  select {
    background: #fff;
    border: 1px solid var(--line-strong);
    border-radius: 5px;
    color: var(--ink);
    padding: 6px 9px;
  }

  button {
    cursor: pointer;
  }

  button.active {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }

  select {
    min-width: 180px;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin-top: 12px;
    min-width: 0;
  }

  .fact {
    background: #faf9f3;
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 9px 10px;
    min-height: 68px;
  }

  .fact .label {
    color: var(--muted);
    font: 11px/1.3 var(--mono);
    text-transform: uppercase;
  }

  .fact .value {
    font-size: 16px;
    font-weight: 650;
    margin-top: 3px;
  }

  .fact .sub {
    color: var(--soft);
    font-size: 12px;
    margin-top: 1px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border-radius: 999px;
    padding: 2px 8px;
    font: 11px/1.5 var(--mono);
    border: 1px solid var(--line-strong);
    background: #fff;
    color: var(--soft);
  }

  .badge.good { color: var(--green); background: var(--green-bg); border-color: #afcfb0; }
  .badge.warn { color: var(--gold); background: var(--gold-bg); border-color: #d6c18f; }
  .badge.bad { color: var(--red); background: var(--red-bg); border-color: #d8b3af; }

  .prompt-diff {
    font-family: var(--mono);
    font-size: 12.5px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: #fbfaf5;
    padding: 10px;
    min-height: 78px;
  }

  .diff-change {
    background: var(--gold-bg);
    color: var(--gold);
    border-bottom: 2px solid #c69e45;
    border-radius: 2px;
    padding: 0 1px;
  }

  .diff-change.empty {
    font-style: italic;
  }

  .diff-label {
    display: inline-block;
    font-weight: 650;
    color: var(--ink);
    margin-right: 6px;
  }

  .ws-glyph {
    color: #c69e45;
    opacity: .85;
    font-weight: 650;
  }

  .edit-summary {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 10px;
    font-size: 12.5px;
    color: var(--soft);
  }

  .edit-summary .edit-kicker {
    font: 11px/1.4 var(--mono);
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .edit-summary .edit-body {
    font-family: var(--mono);
    color: var(--gold);
    background: var(--gold-bg);
    padding: 1px 8px;
    border-radius: 4px;
    border: 1px solid #d7bf8b;
  }

  .token-line {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 9px;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: #fbfaf5;
    font-family: var(--mono);
    font-size: 12px;
  }

  .tok {
    white-space: pre;
    border: 1px solid #c9c6bb;
    border-radius: 4px;
    background: #efeee8;
    color: #262b31;
    padding: 1px 5px;
    min-height: 22px;
  }

  .tok.common { background: #eeede7; }
  .tok.prompt_lcp { background: var(--blue-bg); color: var(--blue); border-color: #aac5d0; font-weight: 650; }
  .tok.post_lcp { background: var(--gold-bg); color: var(--gold); border-color: #d7bf8b; }
  .tok.branch { background: var(--violet-bg); color: var(--violet); border-color: #b9afd4; font-weight: 650; }
  .tok.a { background: var(--green-bg); color: var(--green); border-color: #afcfb0; }
  .tok.b { background: var(--red-bg); color: var(--red); border-color: #d8b3af; }
  .tok.ellipsis { color: var(--muted); background: #f3f2ec; }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    color: var(--muted);
    font-size: 12px;
    margin-top: 7px;
  }

  .timeline-bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 120px;
    padding: 10px 8px 18px;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: #fbfaf5;
    overflow-x: auto;
  }

  .bar {
    min-width: 10px;
    border-radius: 2px 2px 0 0;
    background: var(--blue);
    opacity: .78;
    position: relative;
  }

  .bar.same { background: var(--slate); opacity: .45; }
  .bar.branch { background: var(--violet); opacity: 1; outline: 2px solid var(--ink); }
  .bar.selected { outline: 2px solid var(--gold); }

  .bar.branch::after {
    content: attr(data-label);
    position: absolute;
    left: 50%;
    top: -20px;
    transform: translateX(-50%);
    color: var(--violet);
    font: 10.5px/1 var(--mono);
    white-space: nowrap;
  }

  .bar.branch.branch-start::after {
    left: 0;
    transform: none;
  }

  .topk {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 10px;
  }

  .prob-row {
    display: grid;
    grid-template-columns: 78px minmax(0, 1fr) 48px;
    align-items: center;
    gap: 8px;
    margin: 5px 0;
    font-family: var(--mono);
    font-size: 12px;
  }

  .prob-token {
    overflow: hidden;
    white-space: pre;
    text-overflow: ellipsis;
  }

  .prob-track {
    background: #ebe9df;
    border-radius: 999px;
    overflow: hidden;
    height: 8px;
  }

  .prob-fill {
    height: 100%;
    background: var(--blue);
  }

  .prob-fill.b {
    background: var(--red);
  }

  .heat-wrap {
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: #fbfaf5;
    padding: 8px;
  }

  .heatmap {
    display: grid;
    gap: 2px;
    min-width: max-content;
  }

  .heat-label {
    font: 10.5px/1.2 var(--mono);
    color: var(--muted);
    padding: 3px 4px;
    white-space: nowrap;
    text-align: center;
  }

  .heat-y {
    text-align: right;
    padding-right: 5px;
  }

  .heat-cell {
    width: var(--heat-cell-size, 18px);
    height: var(--heat-cell-size, 18px);
    justify-self: center;
    border-radius: 2px;
    border: 1px solid rgba(0, 0, 0, .08);
    cursor: pointer;
  }

  .heat-cell.selected {
    outline: 2px solid var(--ink);
    outline-offset: 1px;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px;
  }

  .detail {
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 8px;
    background: #faf9f3;
  }

  .detail .label {
    color: var(--muted);
    font: 10.5px/1.3 var(--mono);
    text-transform: uppercase;
  }

  .detail .value {
    font-weight: 650;
    margin-top: 3px;
    overflow-wrap: anywhere;
  }

  .feature-bars {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .feature-row {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr) 52px;
    gap: 8px;
    align-items: center;
    font-family: var(--mono);
    font-size: 12px;
    margin: 5px 0;
  }

  .feature-id {
    color: var(--soft);
  }

  .source-list {
    display: grid;
    gap: 8px;
    font-size: 12.5px;
    color: var(--soft);
  }

  .source-list code {
    color: var(--ink);
    font-family: var(--mono);
    overflow-wrap: anywhere;
  }

  .how-to-read {
    margin: 0 0 22px;
  }

  .patch-legend {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 10px;
    row-gap: 6px;
    align-items: center;
    margin: 8px 0 14px;
    color: var(--soft);
    font-size: 12.5px;
    max-width: 720px;
  }

  .contract-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 8px 16px;
    color: var(--soft);
    font-size: 13px;
    line-height: 1.45;
  }

  .contract-list li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .contract-list .badge {
    flex-shrink: 0;
    margin-top: 1px;
  }

  @media (max-width: 900px) {
    .shell { grid-template-columns: 1fr; }
    .rail { position: static; height: auto; width: 100%; }
    main { padding: 20px 16px 60px; }
    .case-cards, .grid2, .grid3, .facts, .topk, .detail-grid, .feature-bars {
      grid-template-columns: 1fr;
    }
  }
</style>
</head>
<body>
<script id="bundle" type="application/json">{{ bundle_json|safe }}</script>
<div class="shell">
  <aside class="rail">
    <div class="brand">Branch signatures</div>
    <h1>Interactive lab</h1>
    <nav class="nav">
      <a href="#case" class="active">Pick an example</a>
      <a href="#tokens">A/B prompts</a>
      <a href="#logits">First output split</a>
      <a href="#patch">Which hidden state flips B toward A</a>
      <a href="#panel">Across 82 cases</a>
    </nav>
    <div class="meta">
      <div>{{ bundle.schema_version }}</div>
      <div>{{ bundle.generated_at }}</div>
    </div>
  </aside>
  <main>
    <div class="hero">
      <div class="kicker">Generated from repo artifacts - 82 cases, 3 examples</div>
      <h2>When a tiny formatting edit changes the output, where does the divergence live?</h2>
      <p>Each example below is a real prompt pair that differs by one tiny formatting edit. We force both prompts through the same visible tokens, watch where their next-token distributions start to differ, and test which hidden state can be copied from A into B to undo the branch.</p>
    </div>

    <section id="contract" class="how-to-read">
      <div class="panel contract">
        <h4>How to read this</h4>
        <ul class="contract-list">
          <li><span class="badge good">A</span> the original prompt</li>
          <li><span class="badge bad">B</span> the same prompt with a tiny formatting edit</li>
          <li><span class="badge">split</span> the first generated token where A and B disagree</li>
          <li><span class="badge">patch</span> copy one hidden-state vector from A into B at a layer and token</li>
          <li><span class="badge good">score 1</span> B switches to A's choice. <span class="badge">0</span> no effect. <span class="badge bad">negative</span> pushes B further away.</li>
        </ul>
      </div>
    </section>

    <section id="case">
      <h3>Pick an example</h3>
      <p>The first card is the recommended starting point: it has a visible shared runway before the branch. The other two show why the same patching test produces different signatures.</p>
      <div class="panel">
        <div class="case-cards" id="caseButtons"></div>
        <div class="case-detail">
          <div id="caseTitle" class="case-name"></div>
          <div id="caseWhy"></div>
        </div>
        <div class="facts" id="caseFacts"></div>
      </div>
    </section>

    <section id="tokens">
      <h3>A/B prompts</h3>
      <p>A is the original prompt. B is the same prompt with a tiny formatting edit (the highlighted span). The generated runway below shows the shared tokens both runs emit before they split.</p>
      <div class="panel">
        <h4>Prompt text diff</h4>
        <div class="edit-summary" id="promptEditSummary"></div>
        <div class="prompt-diff" id="promptDiffA"></div>
        <div style="height:8px"></div>
        <div class="prompt-diff" id="promptDiffB"></div>
      </div>
      <div class="panel" style="margin-top:12px">
        <h4>Generated runway</h4>
        <div id="generatedRunway" class="token-line"></div>
      </div>
      <details class="disclosure">
        <summary>Tokenizer details: the prompt window by token</summary>
        <p>How each prompt looks after tokenization, centered on the first differing token. Blue = first tokenized prompt difference. Gold = tokens after that difference. Gray = identical prompt context.</p>
        <div id="promptTokensA" class="token-line"></div>
        <div style="height:8px"></div>
        <div id="promptTokensB" class="token-line"></div>
        <div class="legend">
          <span><span class="badge">common</span></span>
          <span><span class="badge good">A side</span></span>
          <span><span class="badge bad">B side</span></span>
        </div>
      </details>
    </section>

    <section id="logits">
      <h3>When the model split</h3>
      <p>Each bar measures how different the two next-token distributions are while both runs are pinned to the same shared visible prefix. Gray bars mean both sides still had the same top token; blue bars mean their top choices differed; the marked violet bar is the first visible branch.</p>
      <div class="panel">
        <div class="inline-note" id="logitNote"></div>
        <div class="timeline-bars" id="logitBars"></div>
        <div class="controls" style="margin-top:12px">
          <label for="logitStep">t</label>
          <input id="logitStep" type="range" min="0" max="0" value="0" />
          <span class="badge" id="logitStepLabel"></span>
        </div>
        <div class="topk" id="topkPanel"></div>
      </div>
    </section>

    <section id="patch">
      <h3>Which hidden state flips B toward A</h3>
      <p>Each cell copies one hidden-state vector from A into B at this layer and token. The score asks whether B moves toward A's first differing token.</p>
      <div class="patch-legend">
        <span class="badge bad">negative</span><span>patch pushes B further away / strengthens B's original choice</span>
        <span class="badge">0</span><span>no useful movement</span>
        <span class="badge good">1</span><span>full rescue: B now prefers A's branch token</span>
        <span class="badge warn">&gt;1</span><span>stronger-than-needed rescue</span>
      </div>
      <div class="panel">
        <div class="controls">
          <button data-filter="important" class="filter active">Key positions</button>
          <button data-filter="all" class="filter">All positions</button>
        </div>
        <p><strong>Key positions</strong> means the prompt edit token, the token immediately before the split, and the strongest observed token from each other position type. When the split happens after shared generated text, this is the last shared token.</p>
        <details class="disclosure">
          <summary>More filters</summary>
          <div class="controls">
            <button data-filter="prompt_lcp" class="filter">Prompt edit token</button>
            <button data-filter="aligned_prompt_control" class="filter">Prompt controls</button>
            <button data-filter="generated_prefix" class="filter">Generated prefix</button>
            <button data-filter="final_context" class="filter">Token before branch</button>
          </div>
        </details>
        <div class="heat-wrap">
          <div id="heatmap" class="heatmap"></div>
        </div>
        <details class="disclosure">
          <summary>Explore cells manually</summary>
          <div class="controls">
            <select id="positionSelect"></select>
            <label for="layerSelect">layer</label>
            <input id="layerSelect" type="range" min="0" max="0" value="0" />
            <span class="badge" id="layerLabel"></span>
          </div>
        </details>
        <div class="detail-grid" id="patchDetails"></div>
      </div>
    </section>

    <section id="panel">
      <h3>Across 82 cases</h3>
      <p>In this 82-case sample of tiny formatting edits, we sort each pair by where the signal lives:</p>
      <div class="grid3" id="panelCounts"></div>
      <details class="disclosure">
        <summary>Sources and provenance</summary>
        <div class="source-list" id="sourceList"></div>
      </details>
      <details class="disclosure">
        <summary>Advanced: SAE feature activations (two Qwen cases)</summary>
        <p>A pilot diagnostic. Shows real SAE feature IDs, not human-readable labels.</p>
        <div class="controls">
          <select id="saeCase"></select>
          <select id="saeGroup"></select>
          <span class="badge" id="saeOverlap"></span>
        </div>
        <div class="feature-bars" id="featureBars"></div>
      </details>
    </section>
  </main>
</div>

<script>
const DATA = JSON.parse(document.getElementById("bundle").textContent);
const state = {
  caseId: DATA.default_case_id,
  filter: "important",
  selectedPosition: null,
  selectedLayer: null,
  selectedLogitT: null,
  saeCaseId: DATA.sae_cases[0]?.id || null,
  saeGroupIndex: 0
};

const $ = (id) => document.getElementById(id);

function esc(value) {
  return String(value ?? "").replace(/[&<>"']/g, (m) => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#039;"
  }[m]));
}

function tokenText(value) {
  const raw = String(value ?? "");
  const shown = raw
    .replace(/\r/g, "\\r")
    .replace(/\n/g, "\\n")
    .replace(/\t/g, "\\t");
  return shown.length ? shown : "[empty]";
}

function pct(x) {
  if (x === null || x === undefined || Number.isNaN(Number(x))) return "NA";
  return `${(Number(x) * 100).toFixed(1)}%`;
}

function num(x, digits = 2) {
  if (x === null || x === undefined || Number.isNaN(Number(x))) return "NA";
  return Number(x).toFixed(digits);
}

function currentCase() {
  return DATA.cases.find((c) => c.id === state.caseId) || DATA.cases[0];
}

function classLabel(cls) {
  return {
    edit_boundary: "prompt edit already carries the signal",
    trajectory_migration: "signal moves into shared generated text",
    prompt_accumulation: "immediate split / no shared generated text",
    prompt_lcp: "prompt edit token",
    aligned_prompt_control: "prompt control",
    generated_prefix: "generated prefix",
    final_context: "token before branch"
  }[cls] || cls;
}

function rescueOutcome(value) {
  const n = Number(value ?? 0);
  if (n >= 1.05) return "full rescue + overshoot";
  if (n >= 0.99) return "full rescue";
  if (n >= 0.5) return "partial rescue";
  if (n > 0.05) return "weak rescue";
  if (n < -0.05) return "pushes B further away";
  return "no movement";
}

function scoreText(value, digits = 2) {
  return `score ${num(value, digits)}`;
}

function scoreWithOutcome(value, digits = 2) {
  return `${scoreText(value, digits)}: ${rescueOutcome(value)}`;
}

function caseMetric(c) {
  const p = c.patch.summary;
  if (c.regime === "trajectory_migration") {
    return `generated-prefix patch: ${rescueOutcome(p.best_generated_prefix_rescue_fraction)}`;
  }
  return `prompt-side patch: ${rescueOutcome(p.prompt_lcp_rescue_fraction)}`;
}

function bestPatchText(p) {
  return `${classLabel(p.best_position_class)}, layer ${p.best_layer}`;
}

function positionClassHint(cls, c) {
  if (cls === "final_context") {
    if (Number(c.generation.branch_t) === 0) {
      return "Here the branch is at t=0, so this is the last prompt token.";
    }
    return "This is the last shared token before the branch prediction.";
  }
  if (cls === "prompt_lcp") {
    return "This is the first tokenized prompt position where the two prompt versions differ.";
  }
  if (cls === "generated_prefix") {
    return "This is one of the shared generated tokens before the branch.";
  }
  if (cls === "aligned_prompt_control") {
    return "This is another prompt-side token used as a control position.";
  }
  return "";
}

function generatedPrefixFact(c) {
  const score = c.patch.summary.best_generated_prefix_rescue_fraction;
  if (Number(c.generation.branch_t) === 0) {
    return ["Generated-prefix patch", "Not applicable", "No shared generated tokens exist before a t=0 branch."];
  }
  return ["Generated-prefix patch", rescueOutcome(score), `${scoreWithOutcome(score)} at the best generated-prefix position.`];
}

function describeEdit(a, b) {
  const describe = (s) => {
    if (s === "" || s === null || s === undefined) return "nothing";
    if (/^\n+$/.test(s)) return s.length === 1 ? "newline" : `${s.length} newlines`;
    if (/^ +$/.test(s)) return s.length === 1 ? "space" : `${s.length} spaces`;
    if (/^\t+$/.test(s)) return "tab";
    if (/^\s+$/.test(s)) return "whitespace";
    return `"${s.replace(/\n/g, "\\n").replace(/\t/g, "\\t")}"`;
  };
  return `${describe(a)} → ${describe(b)}`;
}

function caseCardFields(c) {
  const p = c.patch.summary;
  const editText = describeEdit(c.prompt.diff.a_changed, c.prompt.diff.b_changed);
  const branch = Number(c.generation.branch_t);
  const firstSplit = branch === 0
    ? "token 0 (no shared runway)"
    : `after ${branch} shared token${branch === 1 ? "" : "s"}`;
  const best = `${classLabel(p.best_position_class)}, layer ${p.best_layer} (${rescueOutcome(p.best_rescue_fraction)})`;
  return [
    ["edit", editText],
    ["first split", firstSplit],
    ["best fix", best]
  ];
}

function renderCaseButtons() {
  $("caseButtons").innerHTML = DATA.cases.map((c) => {
    const fields = caseCardFields(c).map(([k, v]) => (
      `<div class="case-field"><span class="case-field-label">${esc(k)}</span><span class="case-field-value">${esc(v)}</span></div>`
    )).join("");
    return `<button class="case-card ${c.id === state.caseId ? "active" : ""}" data-case="${esc(c.id)}">
      <div class="case-card-title">${esc(c.short_label)}</div>
      <div class="case-card-fields">${fields}</div>
      <div class="case-card-meta">
        ${c.is_default ? '<span class="badge good">recommended start</span>' : '<span></span>'}
      </div>
    </button>`;
  }).join("");
  $("caseButtons").querySelectorAll("button").forEach((button) => {
    button.addEventListener("click", () => {
      state.caseId = button.dataset.case;
      state.selectedPosition = null;
      state.selectedLayer = null;
      state.selectedLogitT = null;
      renderAll();
      document.getElementById("case").scrollIntoView({block: "start"});
    });
  });
}

function renderCase() {
  const c = currentCase();
  const p = c.patch.summary;
  $("caseTitle").textContent = c.title;
  $("caseWhy").innerHTML = `
    <div class="case-id">${esc(c.model.name)} / ${esc(c.pair_id)}</div>
    <p>${esc(c.why)}</p>
    <p>
      <span class="badge">${esc(classLabel(c.regime))}</span>
      ${c.generation.branch_t === 0 ? '<span class="badge warn">branches at t=0</span>' : ''}
    </p>`;
  const facts = [
    ["First changed token", `t=${c.generation.branch_t}`, `A predicts ${tokenText(c.generation.a_branch_token)}; B predicts ${tokenText(c.generation.b_branch_token)}.`],
    ["Patch score scale", "0 = none; 1 = full", "Above 1 means the patch pushes farther toward A than the clean run did."],
    ["Best patch found", bestPatchText(p), `${scoreWithOutcome(p.best_rescue_fraction)}. ${positionClassHint(p.best_position_class, c)}`],
    generatedPrefixFact(c)
  ];
  $("caseFacts").innerHTML = facts.map(([label, value, sub]) => `
    <div class="fact">
      <div class="label">${esc(label)}</div>
      <div class="value">${esc(value)}</div>
      <div class="sub">${esc(sub)}</div>
    </div>`).join("");
}

function visibleWhitespace(s) {
  if (!s) return "";
  return esc(s)
    .replace(/ /g, '<span class="ws-glyph">·</span>')
    .replace(/\t/g, '<span class="ws-glyph">→</span>')
    .replace(/\n/g, '<span class="ws-glyph">¶</span>\n');
}

function renderDiffLine(diff, side, label) {
  const pre = side === "a" ? diff.a_before : diff.b_before;
  const changed = side === "a" ? diff.a_changed : diff.b_changed;
  const after = side === "a" ? diff.a_after : diff.b_after;
  const changedHtml = changed === "" ? '<span class="diff-change empty">[empty]</span>'
    : `<span class="diff-change">${visibleWhitespace(changed)}</span>`;
  return `<span class="diff-label">${esc(label)}</span> ${esc(pre)}${changedHtml}${esc(after)}`;
}

function tokenChip(tok, extraClass = "") {
  const text = tokenText(tok.text ?? tok.token ?? tok.a_token ?? "");
  const role = tok.role || "";
  const title = tok.token_id !== undefined ? `#${tok.index} id=${tok.token_id}` : "";
  return `<span class="tok ${esc(role)} ${esc(extraClass)}" title="${esc(title)}">${esc(text || " ")}</span>`;
}

function renderTokens() {
  const c = currentCase();
  const diff = c.prompt.diff;
  const editText = describeEdit(diff.a_changed, diff.b_changed);
  $("promptEditSummary").innerHTML = `<span class="edit-kicker">Edit</span> <span class="edit-body">${esc(editText)}</span>`;
  $("promptDiffA").innerHTML = renderDiffLine(diff, "a", "A (original)");
  $("promptDiffB").innerHTML = renderDiffLine(diff, "b", "B (edited)");
  $("promptTokensA").innerHTML = `<span class="badge good">A</span>` + c.prompt.token_window.a.map(tokenChip).join("");
  $("promptTokensB").innerHTML = `<span class="badge bad">B</span>` + c.prompt.token_window.b.map(tokenChip).join("");

  const branch = Number(c.generation.branch_t);
  const rows = c.logit_timeline;
  const start = Math.max(0, branch - 8);
  const end = Math.min(rows.length - 1, branch + 6);
  const parts = [];
  if (start > 0) parts.push(`<span class="tok ellipsis">... ${start} earlier</span>`);
  for (const row of rows) {
    if (row.t < start || row.t > end) continue;
    if (row.t === branch) {
      parts.push(`<span class="tok branch">t=${row.t}</span>`);
      parts.push(`<span class="tok a">A:${esc(tokenText(row.a_token))}</span>`);
      parts.push(`<span class="tok b">B:${esc(tokenText(row.b_token))}</span>`);
    } else {
      parts.push(`<span class="tok common" title="t=${row.t}, JS=${num(row.js, 4)}">${esc(tokenText(row.a_token))}</span>`);
    }
  }
  $("generatedRunway").innerHTML = parts.join("");
}

function renderLogits() {
  const c = currentCase();
  const rows = c.logit_timeline;
  const maxJs = Math.max(0.0001, ...rows.map((r) => Number(r.js || 0)));
  const branch = Number(c.generation.branch_t);
  if (state.selectedLogitT === null) state.selectedLogitT = branch;
  $("logitNote").innerHTML = branch === 0
    ? "This edge case branches immediately at t=0, so there is no pre-branch generated runway in the chart."
    : `The visible branch is at t=${branch}. Bars before that can still be nonzero because the two distributions may lean differently even while the visible token stays shared.`;
  $("logitStep").min = rows[0]?.t ?? 0;
  $("logitStep").max = rows[rows.length - 1]?.t ?? 0;
  $("logitStep").value = state.selectedLogitT;
  $("logitStepLabel").textContent = `t=${state.selectedLogitT}`;
  $("logitBars").innerHTML = rows.map((r) => {
    const h = Math.max(3, Math.round(95 * Number(r.js || 0) / maxJs));
    const cls = [
      "bar",
      r.top1_same ? "same" : "",
      r.t === branch ? "branch" : "",
      r.t === branch && r.t === rows[0]?.t ? "branch-start" : "",
      r.t === Number(state.selectedLogitT) ? "selected" : ""
    ].join(" ");
    const title = r.top1_same
      ? `t=${r.t} JS=${num(r.js, 4)} shared top token=${tokenText(r.a_token)}`
      : `t=${r.t} JS=${num(r.js, 4)} A=${tokenText(r.a_token)} B=${tokenText(r.b_token)}`;
    const label = r.t === branch ? `branch t=${branch}` : "";
    return `<div class="${cls}" style="height:${h}px" title="${esc(title)}" data-label="${esc(label)}" data-t="${r.t}"></div>`;
  }).join("");
  $("logitBars").querySelectorAll(".bar").forEach((bar) => {
    bar.addEventListener("click", () => {
      state.selectedLogitT = Number(bar.dataset.t);
      renderLogits();
    });
  });
  $("logitStep").oninput = (event) => {
    state.selectedLogitT = Number(event.target.value);
    renderLogits();
  };
  renderTopK();
}

function renderTopK() {
  const c = currentCase();
  const row = c.logit_timeline.find((r) => r.t === Number(state.selectedLogitT)) || c.logit_timeline[0];
  const renderSide = (label, topk, sideClass) => `
    <div>
      <h4>${esc(label)} distribution</h4>
      ${(topk || []).map((tok) => `
        <div class="prob-row">
          <div class="prob-token">${esc(tokenText(tok.token))}</div>
          <div class="prob-track"><div class="prob-fill ${sideClass}" style="width:${Math.max(2, Number(tok.prob || 0) * 100)}%"></div></div>
          <div>${pct(tok.prob)}</div>
        </div>`).join("")}
    </div>`;
  $("topkPanel").innerHTML = renderSide("A", row.topk_a, "a") + renderSide("B", row.topk_b, "b");
}

function positionMap(c) {
  const m = new Map();
  c.patch.grid.positions.forEach((p) => m.set(p.label, p));
  return m;
}

function importantPositions(c) {
  const labels = new Set(["prompt_lcp_token", "final_context_token"]);
  const p = c.patch.summary;
  if (p.best_position_label) labels.add(p.best_position_label);
  c.patch.grid.class_summaries.forEach((s) => labels.add(s.best_position_label));
  return c.patch.grid.positions.filter((pos) => labels.has(pos.label));
}

function visiblePositions(c) {
  if (state.filter === "important") return importantPositions(c);
  if (state.filter === "all") return c.patch.grid.positions;
  return c.patch.grid.positions.filter((p) => p.class === state.filter);
}

function colorForRescue(value) {
  const raw = Number(value || 0);
  if (raw < -0.05) {
    const t = Math.min(1, -raw / 1.0);
    const light = 90 - 38 * t;
    return `hsl(0, 46%, ${light}%)`;
  }
  const v = Math.max(0, Math.min(1.5, raw)) / 1.5;
  const hue = 24 + (145 - 24) * v;
  const light = 90 - 38 * v;
  return `hsl(${hue}, 46%, ${light}%)`;
}

function renderPatch() {
  const c = currentCase();
  const positions = visiblePositions(c);
  const layers = c.patch.grid.layers;
  const cellsByKey = new Map(c.patch.grid.cells.map((cell) => [`${cell.layer}|${cell.position_label}`, cell]));
  const summary = c.patch.summary;
  const best = cellsByKey.get(`${summary.best_layer}|${summary.best_position_label}`) || c.patch.grid.best_cell;
  if (!state.selectedPosition || !positions.some((p) => p.label === state.selectedPosition)) {
    state.selectedPosition = positions.some((p) => p.label === best.position_label) ? best.position_label : positions[0]?.label;
  }
  if (state.selectedLayer === null || !layers.includes(Number(state.selectedLayer))) {
    state.selectedLayer = best.layer ?? layers[0];
  }

  const colWidth = positions.length <= 8 ? 86 : (positions.length <= 40 ? 52 : 42);
  $("heatmap").style.gridTemplateColumns = `56px repeat(${positions.length}, ${colWidth}px)`;
  $("heatmap").style.setProperty("--heat-cell-size", `${Math.min(24, colWidth - 10)}px`);
  const html = [];
  html.push(`<div class="heat-label"></div>`);
  positions.forEach((p) => html.push(`<div class="heat-label" title="${esc(p.label)}">${esc(p.short_label)}</div>`));
  layers.forEach((layer) => {
    html.push(`<div class="heat-label heat-y">L${layer}</div>`);
    positions.forEach((pos) => {
      const cell = cellsByKey.get(`${layer}|${pos.label}`);
      if (!cell) {
        html.push(`<div></div>`);
        return;
      }
      const selected = cell.layer === Number(state.selectedLayer) && cell.position_label === state.selectedPosition;
      html.push(`<div class="heat-cell ${selected ? "selected" : ""}" style="background:${colorForRescue(cell.rescue_fraction)}" title="${esc(pos.label)} L${layer} ${scoreWithOutcome(cell.rescue_fraction, 3)} top1=${esc(cell.top1_token)}" data-layer="${layer}" data-pos="${esc(pos.label)}"></div>`);
    });
  });
  $("heatmap").innerHTML = html.join("");
  $("heatmap").querySelectorAll(".heat-cell").forEach((cell) => {
    cell.addEventListener("click", () => {
      state.selectedLayer = Number(cell.dataset.layer);
      state.selectedPosition = cell.dataset.pos;
      renderPatch();
    });
  });

  $("positionSelect").innerHTML = c.patch.grid.positions.map((p) => (
    `<option value="${esc(p.label)}" ${p.label === state.selectedPosition ? "selected" : ""}>${esc(p.short_label)} - ${esc(classLabel(p.class))}</option>`
  )).join("");
  $("positionSelect").onchange = (event) => {
    state.selectedPosition = event.target.value;
    renderPatch();
  };

  $("layerSelect").min = Math.min(...layers);
  $("layerSelect").max = Math.max(...layers);
  $("layerSelect").value = state.selectedLayer;
  $("layerSelect").oninput = (event) => {
    state.selectedLayer = Number(event.target.value);
    renderPatch();
  };
  $("layerLabel").textContent = `L${state.selectedLayer}`;

  const selectedCell = cellsByKey.get(`${state.selectedLayer}|${state.selectedPosition}`) || best;
  const pos = positionMap(c).get(selectedCell.position_label);
  $("patchDetails").innerHTML = [
    ["position", pos?.short_label || selectedCell.position_label],
    ["position type", classLabel(selectedCell.position_class)],
    ["layer", `L${selectedCell.layer}`],
    ["patch score", scoreWithOutcome(selectedCell.rescue_fraction, 3)],
    ["meaning", positionClassHint(selectedCell.position_class, c) || "Selected patch position."],
    ["top-1 after patch", selectedCell.top1_token || "NA"]
  ].map(([label, value]) => `
    <div class="detail">
      <div class="label">${esc(label)}</div>
      <div class="value">${esc(value)}</div>
    </div>`).join("");
}

function setupPatchFilters() {
  document.querySelectorAll(".filter").forEach((button) => {
    button.addEventListener("click", () => {
      state.filter = button.dataset.filter;
      document.querySelectorAll(".filter").forEach((b) => b.classList.toggle("active", b === button));
      state.selectedPosition = null;
      renderPatch();
    });
  });
}

function renderFeatures() {
  if (!DATA.sae_cases.length) {
    $("featureBars").innerHTML = "<p>No SAE artifacts were found.</p>";
    return;
  }
  const selected = DATA.sae_cases.find((c) => c.id === state.saeCaseId) || DATA.sae_cases[0];
  state.saeCaseId = selected.id;
  const group = selected.groups[state.saeGroupIndex] || selected.groups[0];
  $("saeCase").innerHTML = DATA.sae_cases.map((c) => (
    `<option value="${esc(c.id)}" ${c.id === selected.id ? "selected" : ""}>${esc(c.pair_id)}</option>`
  )).join("");
  $("saeCase").onchange = (event) => {
    state.saeCaseId = event.target.value;
    state.saeGroupIndex = 0;
    renderFeatures();
  };
  $("saeGroup").innerHTML = selected.groups.map((g, i) => (
    `<option value="${i}" ${i === state.saeGroupIndex ? "selected" : ""}>L${g.layer} / ${esc(g.position_label)}</option>`
  )).join("");
  $("saeGroup").onchange = (event) => {
    state.saeGroupIndex = Number(event.target.value);
    renderFeatures();
  };
  $("saeOverlap").textContent = `top-10 overlap ${group.top10_overlap}/10`;

  const renderList = (label, rows, cls) => {
    const maxAct = Math.max(0.0001, ...rows.map((r) => Number(r.activation || 0)));
    return `<div><h4>${esc(label)}</h4>${rows.map((r) => `
      <div class="feature-row">
        <div class="feature-id">f${r.feature_id}</div>
        <div class="prob-track"><div class="prob-fill ${cls}" style="width:${Math.max(2, Number(r.activation || 0) / maxAct * 100)}%"></div></div>
        <div>${num(r.activation, 3)}</div>
      </div>`).join("")}</div>`;
  };
  $("featureBars").innerHTML = renderList(`Clean ${group.clean_token ?? ""}`, group.top_clean, "a") +
    renderList(`Corrupt ${group.corrupt_token ?? ""}`, group.top_corrupt, "b");
}

function renderPanel() {
  const p = DATA.panel_summary;
  const counts = p.regime_counts;
  $("panelCounts").innerHTML = [
    ["Prompt edit already carries the signal", counts.edit_boundary, "copying a hidden state at the edited prompt token is enough to flip B."],
    ["Signal moves into shared generated text", counts.trajectory_migration, "A and B emit identical tokens for a while, but the rescue handle is inside that shared generated text."],
    ["Immediate split / no shared generated text", counts.prompt_accumulation, "A and B disagree on the very first generated token, so there is no shared runway to probe."]
  ].map(([label, value, sub]) => `
    <div class="panel">
      <h4>${esc(label)}</h4>
      <div class="fact" style="min-height:0">
        <div class="value">${value}/${p.case_count}</div>
        <div class="sub">${esc(sub)}</div>
      </div>
    </div>`).join("");

  const c = currentCase();
  const sourceItems = Object.values(c.artifacts)
    .filter(Boolean)
    .map((a) => `<div><code>${esc(a.path)}</code></div>`)
    .join("");
  $("sourceList").innerHTML = `
    <div>Strict late-only: ${p.strict_late_only_count}/${p.case_count}. Rule-of-three upper 95% bound ${pct(p.rule_of_three_upper_95)}.</div>
    ${sourceItems}`;
}

function renderAll() {
  renderCaseButtons();
  renderCase();
  renderTokens();
  renderLogits();
  renderPatch();
  renderFeatures();
  renderPanel();
}

setupPatchFilters();
renderAll();
</script>
</body>
</html>
